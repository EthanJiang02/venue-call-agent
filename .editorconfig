# Copied from platform-backend, not from the frontends. The TypeScript already in src/ is
# 4-space, single-quote — the backend's shape — and this repo only ever talks to the backend.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
